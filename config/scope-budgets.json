{
  "version": 1,
  "description": "Blast-radius budgets for the build loop (#8644). A spec's scope can only tighten these defaults; a missing or unknown type gets the strictest entry.",
  "protected_paths": [
    "scripts/*-test.sh",
    "src/**/*.test.ts",
    "tools/arch/**",
    ".github/workflows/**",
    "docs/adr/**",
    ".claude/settings*.json",
    "config/agent-permissions.json",
    "scripts/ci/**"
  ],
  "aliases": {
    "documentation": "docs",
    "hotfix": "bug",
    "enhancement": "feature"
  },
  "types": {
    "docs": {
      "allowed_paths": ["docs/**", "*.md"],
      "max_files_changed": 3,
      "max_lines_added": 60,
      "max_lines_deleted": 30
    },
    "bug": {
      "allowed_paths": ["scripts/**", "src/**", "dashboard/**", "tests/**", "config/**", "docs/**", "*.md"],
      "max_files_changed": 6,
      "max_lines_added": 200,
      "max_lines_deleted": 100
    },
    "feature": {
      "allowed_paths": ["scripts/**", "src/**", "dashboard/**", "tests/**", "config/**", "docs/**", "*.md"],
      "max_files_changed": 12,
      "max_lines_added": 500,
      "max_lines_deleted": 150
    },
    "refactor": {
      "allowed_paths": ["scripts/**", "src/**", "dashboard/**", "tests/**", "config/**", "docs/**", "*.md"],
      "max_files_changed": 12,
      "max_lines_added": 400,
      "max_lines_deleted": 200
    },
    "unknown": {
      "allowed_paths": ["docs/**", "*.md"],
      "max_files_changed": 2,
      "max_lines_added": 40,
      "max_lines_deleted": 20
    }
  }
}
