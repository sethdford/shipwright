{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAllHooks": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git restore *)",
      "Bash(mkdir *)",
      "Bash(chmod +x *)",
      "Bash(shellcheck *)",
      "Bash(jq *)",
      "Bash(bash scripts/*-test.sh)",
      "Bash(bash scripts/*-test.sh *)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(go test *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(make test)",
      "Bash(make test *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(gh *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(telnet *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(*base-repin*)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(git clone *)",
      "Bash(git submodule *)",
      "Bash(git credential *)",
      "Bash(git -c *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Read(~/.config/**)",
      "Edit(~/.config/**)",
      "Write(~/.config/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(~/Library/Keychains/**)",
      "Edit(//home/runner/work/_temp/**)",
      "Write(//home/runner/work/_temp/**)",
      "Edit(.claude/settings*.json)",
      "Write(.claude/settings*.json)",
      "Edit(config/agent-permissions.json)",
      "Write(config/agent-permissions.json)",
      "Edit(scripts/lib/agent-exec.sh)",
      "Write(scripts/lib/agent-exec.sh)",
      "Edit(scripts/lib/models.sh)",
      "Write(scripts/lib/models.sh)",
      "Edit(scripts/lib/agent-sandbox.sh)",
      "Write(scripts/lib/agent-sandbox.sh)",
      "Edit(scripts/ci/**)",
      "Write(scripts/ci/**)",
      "Edit(config/models.json)",
      "Write(config/models.json)",
      "Edit(tools/models/**)",
      "Write(tools/models/**)",
      "Edit(scripts/lib/test-gate-env.sh)",
      "Write(scripts/lib/test-gate-env.sh)",
      "Edit(scripts/lib/pipeline-base.sh)",
      "Write(scripts/lib/pipeline-base.sh)",
      "Edit(scripts/lib/test-gate-baseline.sh)",
      "Write(scripts/lib/test-gate-baseline.sh)",
      "Edit(scripts/lib/pipeline-stages-build.sh)",
      "Write(scripts/lib/pipeline-stages-build.sh)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(tools/arch/**)",
      "Write(tools/arch/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "network": {
      "allowedDomains": []
    },
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.config/gh", "~/.netrc", "~/.aws", "~/.gnupg", "~/Library/Keychains"]
    }
  }
}
