{
  "$id": "https://shipwright.dev/schemas/specification.json",
  "title": "Shipwright Specification",
  "description": "Structured specification for agent-driven development. Captures intent, constraints, and acceptance criteria so agents work from specs, not just natural language issues.",
  "type": "object",
  "required": ["version", "title", "goals", "acceptance_criteria"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Specification schema version"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short title describing what this spec covers"
    },
    "source": {
      "type": "object",
      "description": "Where this spec originated",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["github_issue", "goal", "manual", "decomposed"]
        },
        "issue_number": { "type": "integer" },
        "url": { "type": "string", "format": "uri" },
        "parent_spec": { "type": "string" }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "What the code should accomplish (intent, not implementation)"
      },
      "description": "Primary goals this implementation must achieve"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "What the code must NOT do or boundaries it must respect"
      },
      "default": [],
      "description": "Constraints and boundaries"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "testable"],
        "properties": {
          "criterion": {
            "type": "string",
            "description": "A specific, measurable acceptance criterion"
          },
          "testable": {
            "type": "boolean",
            "description": "Whether this criterion can be verified automatically"
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "unit_test",
              "integration_test",
              "manual",
              "static_analysis",
              "formal_verification"
            ],
            "description": "How this criterion should be verified"
          }
        }
      },
      "description": "Testable criteria for spec compliance"
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "expected_behavior"],
        "properties": {
          "scenario": { "type": "string" },
          "expected_behavior": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "default": "medium"
          }
        }
      },
      "default": [],
      "description": "Edge cases that must be handled"
    },
    "security_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Security constraints (input validation, auth, etc.)"
    },
    "performance_requirements": {
      "type": "object",
      "properties": {
        "max_latency_ms": { "type": "integer" },
        "max_memory_mb": { "type": "integer" },
        "throughput_rps": { "type": "integer" },
        "notes": { "type": "string" }
      },
      "description": "Performance bounds (optional)"
    },
    "affected_files": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Files expected to be modified (from analysis)"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Other specs or issues this depends on"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "complexity": {
          "type": "string",
          "enum": ["trivial", "simple", "moderate", "complex", "very_complex"]
        },
        "estimated_files": { "type": "integer" },
        "language": { "type": "string" }
      }
    }
  }
}
